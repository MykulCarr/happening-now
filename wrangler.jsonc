{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-pages",
  "compatibility_date": "2026-04-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".deploy-public"
    // html_handling stays at the default ("auto-trailing-slash") so requests
    // to /weather still serve /weather.html's content without a redirect.
    // Our _redirects file declares explicit 301s for the reverse direction
    // (/weather.html → /weather), and Cloudflare evaluates _redirects rules
    // before the auto-handling so the 301 wins over the default 307.
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "happening-now.net/*",
      "zone_name": "happening-now.net"
    }
  ],

  // Beta: scripts/deploy-beta.ps1. Same staged files, on its own Worker at
  // beta.happening-now.net (a Workers custom domain, so Cloudflare makes the
  // DNS record). Behind Cloudflare Access. /v1/* goes to the beta API Worker
  // via scripts/beta-router.js and the API service binding.
  "env": {
    "beta": {
      "name": "news-pages-beta",
      "main": "scripts/beta-router.js",
      "assets": { "directory": ".deploy-public", "binding": "ASSETS" },
      "routes": [
        { "pattern": "beta.happening-now.net", "custom_domain": true }
      ],
      "workers_dev": false,
      "services": [
        { "binding": "API", "service": "happening-now-sync-beta" }
      ]
    }
  }
}