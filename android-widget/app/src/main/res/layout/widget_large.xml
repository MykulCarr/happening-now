<?xml version="1.0" encoding="utf-8"?>
<!-- Today, sized to fill a launcher page. Three panels on one card, each a
     slightly lighter inset so they read as separate sections of one widget:
     weather, news (category switcher + headlines), watchlist.
     Headline and quote rows are added from code (Render.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="4dp">

    <!-- Top row, laid out like the site's header: the time, the site's name
         (the one thing here that opens the website), the date. The time is a
         smaller size stretched sideways, so it reads wide and low. -->
    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:contentDescription="Opens the clock app"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textScaleX="1.32"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:paddingStart="6dp"
                android:textColor="@color/muted"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Happening Now. Opens the website."
            android:gravity="center"
            android:lineSpacingMultiplier="0.9"
            android:paddingVertical="4dp"
            android:text="HAPPENING\nNOW!"
            android:textColor="@color/brand"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, MMM d"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown only while there is an active weather warning for the saved place. -->
    <TextView
        android:id="@+id/alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/alert_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include layout="@layout/part_weather" />

    <!-- Forecast: the next six hours, then the next five days. Folded away
         until the small arrow on the weather panel is tapped. -->
    <LinearLayout
        android:id="@+id/forecast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bar_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@color/card_edge" />

        <LinearLayout
            android:id="@+id/days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- News panel. Takes all the spare height. A frame, so the two edge
         zones at the bottom of it can lie over the content. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bar_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Category strip: the current category in the middle, its neighbours
             either side, the next ones out fading into the panel edges. A
             widget cannot detect swipes, so you tap a neighbour or the
             chevrons to move. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cat_m2"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:textSize="12sp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:gravity="end|center_vertical"
                    android:textColor="@color/faint" />

                <TextView
                    android:id="@+id/cat_m1"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/cat"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:textSize="14sp"
                    android:layout_width="wrap_content"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.06"
                    android:textColor="@color/accent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cat_p1"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:textSize="12sp"
                    android:layout_width="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/cat_p2"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:paddingHorizontal="9dp"
                    android:textSize="12sp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:textColor="@color/faint" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:id="@+id/fade_l"
                android:background="@drawable/fade_left" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:id="@+id/fade_r"
                android:background="@drawable/fade_right" />

            <TextView
                android:id="@+id/prev"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:contentDescription="Previous category"
                android:gravity="start|center_vertical"
                android:text="‹"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/next"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:contentDescription="Next category"
                android:gravity="end|center_vertical"
                android:text="›"
                android:textColor="@color/text"
                android:textSize="24sp" />
        </FrameLayout>

        <!-- Where Local / Regional cover, or "3 of 14" for the rest -->
        <TextView
            android:id="@+id/catpos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <!-- Each row inside has weight 1, which spreads the headlines evenly
             from the switcher down to the bottom of the panel. -->
        <LinearLayout
            android:id="@+id/headlines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp" />

        <!-- Android 12+: the same headlines as a scrolling list, when there
             are more than fit. Render.kt shows this or the one above. -->
        <ListView
            android:id="@+id/headlines_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:fadingEdgeLength="18dp"
            android:requiresFadingEdge="vertical"
            android:fadeScrollbars="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/scroll_thumb"
            android:scrollbars="vertical"
            android:visibility="gone" />
    </LinearLayout>

        <!-- Edge zones: the whole left edge of the panel is "previous
             category", the whole right edge "next". The nearest a widget
             gets to a sideways swipe, which the launcher keeps for itself.
             They start below the category strip, which has its own arrows. -->
        <TextView
            android:id="@+id/edge_prev"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginTop="44dp"
            android:contentDescription="Previous category"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/faint"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/edge_next"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="44dp"
            android:contentDescription="Next category"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/faint"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- Watchlist panel -->
    <LinearLayout
        android:id="@+id/watch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bar_bg"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Header: tap to fold the list down to one line (and back), which
             hands the space to the news panel. Folded, `watch_summary` shows
             each symbol's move; open, it is empty. -->
        <LinearLayout
            android:id="@+id/watch_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="WATCHLIST"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/watch_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/watch_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:contentDescription="Widget settings"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/refresh"
            android:layout_width="44dp"
            android:layout_height="30dp"
            android:contentDescription="Refresh now"
            android:gravity="center"
            android:text="↻"
            android:textColor="@color/muted"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>
