<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2: time and date on one row, the weather panel, and the newest story of the chosen category. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- Top row, laid out like the site's header: the time, the site's name
         (the one thing here that opens the website), the date. The time is a
         smaller size stretched sideways, so it reads wide and low. -->
    <LinearLayout
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:contentDescription="Opens the clock app"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="H:mm"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textScaleX="1.32"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="a"
                android:format24Hour=""
                android:paddingStart="6dp"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Happening Now. Opens the website."
            android:gravity="center"
            android:lineSpacingMultiplier="0.9"
            android:paddingVertical="4dp"
            android:text="HAPPENING\nNOW!"
            android:textColor="@color/brand"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, MMM d"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shown only while there is an active weather warning for the saved place. -->
    <TextView
        android:id="@+id/alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/alert_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <include layout="@layout/part_weather" />

    <LinearLayout
        android:id="@+id/story"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="2dp">

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- The news ticker (an option in the app): the category's newest
         headlines one at a time, each sliding in from the right every eight
         seconds. A widget cannot scroll a line of text smoothly, but it can
         flip between views by itself, and only does so while on screen. -->
    <ViewFlipper
        android:id="@+id/ticker"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="8000"
        android:inAnimation="@anim/ticker_in"
        android:outAnimation="@anim/ticker_out"
        android:visibility="gone" />

    <!-- Android 12+: the same headlines as a scrolling list, when there
         are more than fit. Render.kt shows this or the one above. -->
    <ListView
        android:id="@+id/story_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:fadingEdgeLength="18dp"
        android:requiresFadingEdge="vertical"
        android:fadeScrollbars="false"
        android:paddingEnd="8dp"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/scroll_thumb"
        android:scrollbars="vertical"
        android:visibility="gone" />
</LinearLayout>
