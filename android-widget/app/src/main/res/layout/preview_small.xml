        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Partly cloudy" android:textColor="@color/text" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="75° / 58°" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
