<?xml version="1.0" encoding="utf-8"?>
<!-- Standard headline rows: a hairline along the bottom, so it is plain where
     one tappable headline ends and the next begins. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom" android:height="1dp">
        <shape><solid android:color="@color/divider" /></shape>
    </item>
</layer-list>
