{
  "_meta": {
    "version": 1,
    "purpose": "Curated feeds for the topic tabs (Science, Health, Human Interest, Tech, Comics, Vibe Coding, Music, Sports, Entertainment, Gaming, Business, Food, Travel, Environment, Books, Conspiracies, Odd News). Parallel to local-stations.json, which covers the geographic scopes — this covers the topical ones. Users choose which topics appear as tabs in Settings.",
    "schema": {
      "topics": {
        "<topic-id>": {
          "label": "Tab text, kept short — the tab bar is horizontal on phones",
          "title": "<h1> shown on the news page for this topic",
          "emoji": "Shown beside the label in Settings",
          "entries": "[ { name, rss, site, type } ] — same entry shape as local-stations.json",
          "group": "Section heading used to cluster related topics in the Settings picker (e.g. \"Arts & Culture\"). Topics sharing a group render together; group order follows file order of first appearance, topic order within a group is alphabetical by title."
        }
      }
    },
    "howToAdd": [
      "1. Verify the feed through the proxy first, exactly as for local-stations.json:",
      "   curl -s 'https://happening-now.net/v1/rss/raw?url=<urlencoded>' | grep -oE '<(item|entry)[ >]' | wc -l",
      "   Count BOTH item and entry — Atom feeds have no <item> and would look dead.",
      "2. Add under topics.<id>.entries, sorted alphabetically by name.",
      "3. `npm run check-feeds` covers this file too; keep it at zero dead."
    ],
    "notAvailable": {
      "syndicated comics": "GoComics (Peanuts, Garfield, Calvin & Hobbes) and Comics Kingdom (Blondie, Beetle Bailey) both removed public RSS — verified dead on two URL patterns each, 2026-07-26. They're subscription businesses now. Local newspaper comics come from the same syndicates, so those aren't available either. Only independent webcomics publish feeds.",
      "nature.com": "nature.com/nature.rss returns nothing through the proxy — it answered once on 2026-07-26 then failed three consecutive serial retries. Science News and Scientific American cover the same ground reliably."
    },
    "copyright": "Headline + link is normal RSS use and applies to every entry here. Rendering a comic's IMAGE is republishing it, which needs a licence — so an entry may only be displayed as an image if it carries \"embed\": true, and that flag requires a licence that actually permits it, recorded in \"license\". Today only xkcd qualifies (CC BY-NC 2.5, verified at xkcd.com/license.html 2026-07-26); the site is non-commercial and attributes the source, which is what that licence asks. Every other comic is all-rights-reserved: headline and link only. Do not set embed:true without checking the outlet's actual licence page.",
    "conspiraciesTopic": "'conspiracies' is deliberately sourced as journalism ABOUT conspiracies, cover-ups and unexplained phenomena (UAP disclosure reporting, FOIA-based investigation, fact-checking/debunking, a long-running 'strange phenomena' magazine) — not outlets that promote fringe claims as fact. Candidates like disinformation-peddling sites were never added. Keep new entries to that same bar: real reporting or real debunking, not the thing being debunked."
  },
