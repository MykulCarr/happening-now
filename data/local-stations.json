{
  "_meta": {
    "version": 1,
    "purpose": "Curated local TV-station and newspaper RSS feeds used by the Near You / Across Your State source picker. Bundled because no free location-aware news API gave us reliable hyperlocal coverage; see commit history for the rabbit hole.",
    "schema": {
      "states": {
        "<state-abbrev>": {
          "_state": "{ coords: { lat, lon }, entries: [ statewide entries ] } — coords are the state's geographic center (or capital); used to suggest this state as a fallback when no nearby city is in the repo",
          "<lowercase-city>": "{ coords: { lat, lon }, entries: [ entries serving that city ] } — coords are the city's centroid; used to compute nearest-city fallbacks"
        }
      },
      "entry": {
        "name": "Display label shown in the picker (include city + outlet)",
        "rss": "Direct RSS feed URL (validate it returns content before adding!)",
        "site": "Public-facing landing page (used for the favicon and click-through)",
        "type": "tv | paper | community"
      },
      "legacyShape": "An older form where a city's value was just an array of entries (no coords) is still tolerated by getStationsForGeo for backward compat — but new entries MUST include coords so they participate in the nearest-city fallback."
    },
    "howToAdd": [
      "1. Find a candidate RSS URL for the local outlet (TV station, paper, etc.).",
      "2. Verify it returns items via the proxy: curl -s 'https://happening-now.net/v1/rss/raw?url=<urlencoded>' | grep -c '<item'  -- if 0, skip.",
      "3. Add an entry under states.<XX>.<lowercase-city>.entries for hyperlocal, or states.<XX>._state.entries for statewide.",
      "4. When adding a NEW city or state block, include coords: { lat, lon } at the city/state level (decimal degrees, ~4 sig figs). City coords = city centroid; statewide coords = capital or geographic center. Without coords, the city won't appear in nearest-city fallback suggestions.",
      "5. Keep entries sorted alphabetically within each entries array.",
      "6. Lookups are case-insensitive: getStationsForGeo({ city:'Jackson', state:'MI' }) finds states.MI.jackson."
    ]
  },
